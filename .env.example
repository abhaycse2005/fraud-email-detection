# Flask session signing key. Generate a long random value before deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Set to 1 only when serving the app over HTTPS (leave 0 for local HTTP).
SESSION_COOKIE_SECURE=0
# Debug mode is off by default; enable only for local development.
FLASK_DEBUG=0

# Optional initial administrator for a new database. If omitted, no default
# administrator or default password is created. Existing accounts are preserved.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Fernet key used to encrypt Gmail OAuth tokens in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Background scan cadence in seconds (minimum 60; default 180).
GMAIL_SCAN_INTERVAL_SECONDS=180

# Required MongoDB Atlas connection. Both mongodb:// and mongodb+srv:// are supported.
# For a Standard connection, copy the complete generated host list and options
# from Atlas > Connect > Drivers; do not guess or commit credentials.
# MONGODB_URI=mongodb://<db-user>:<url-encoded-password>@<atlas-generated-host-list>/?tls=true&replicaSet=<atlas-generated-replica-set>&authSource=admin&retryWrites=true&w=majority

# Optional credentials used only by the explicit Windows IP-update launcher.
# Create a project-scoped Atlas API key with the Project Network Access Manager
# role (or the equivalent Project IP Access List Admin role when offered).
# These are Atlas Administration API keys, separate from the database user above.
# MONGODB_ATLAS_PUBLIC_KEY=<atlas-api-public-key>
# MONGODB_ATLAS_PRIVATE_KEY=<atlas-api-private-key>
# MONGODB_ATLAS_PROJECT_ID=<24-character-atlas-project-id>

# Gemini Developer API key from Google AI Studio. Free access and quotas depend
# on the Google account/project and are not guaranteed.
GEMINI_API_KEY=your-gemini-api-key
# Optional model ID. Defaults to gemini-3.1-flash-lite; set only a model enabled
# for this Google AI Studio project. Changing this does not verify model access.
GEMINI_MODEL=gemini-3.1-flash-lite

